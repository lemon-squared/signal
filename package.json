{
  "name": "@lemon-squared/signal",
  "version": "0.1.1",
  "type": "module",
  "description": "Cookie consent + Google Consent Mode v2 + GTM loader for Lemon Squared sites.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemon-squared/signal.git"
  },
  "homepage": "https://lemonsquared.co",
  "bugs": "https://github.com/lemon-squared/signal/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@next/third-parties": ">=15.0.0",
    "next": ">=14.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@next/third-parties": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@next/third-parties": "^16.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bunup": "^0.16.11",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "consent-mode",
    "gtm",
    "cookie-consent",
    "google-tag-manager"
  ]
}
